# ── LLM 配置（DeepSeek 默认） ──────────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-EsPorIwgngHMurABN5AY3QvsiAsUyaZr1YOhlhzCMoRbtodL
DEEPSEEK_BASE_URL=http://127.0.0.1:8080/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Ollama 本地模型（免费，零成本） ──────────────────────────────────────────────
# 要使用 Ollama，将上面的 LLM_PROVIDER 注释掉，取消下面这行注释：
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# ── 各 Agent 可单独覆盖模型（可选） ───────────────────────────────────────────
ARCHITECT_MODEL=deepseek-v4-flash
WRITER_MODEL=deepseek-v4-flash
AUDITOR_MODEL=deepseek-v4-pro   # 审计用推理模型效果更好
REVISER_MODEL=deepseek-v4-flash

# ── 写作参数 ───────────────────────────────────────────────────────────────────
DEFAULT_WORDS_PER_CHAPTER=4000
DEFAULT_TEMPERATURE=0.7
AUDITOR_TEMPERATURE=0.0             # 审计员锁温度 0，结果稳定

# ── 项目根目录 ─────────────────────────────────────────────────────────────────
BOOKS_DIR=./books
DEEPSEEK_API_KEY=sk-EsPorIwgngHMurABN5AY3QvsiAsUyaZr1YOhlhzCMoRbtodL
DEEPSEEK_BASE_URL=http://127.0.0.1:8080/v1
DEEPSEEK_MODEL=deepseek-v4-flash

