# ── LLM 配置（使用 NVIDIA 平台） ──────────────────────────────────────────────
LLM_PROVIDER=custom

# DeepSeek 配置（备用）
DEEPSEEK_API_KEY=sk-ed83052d22f344e9a28cf7847ccc128f
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama 配置（本地模型）
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# CUSTOM 配置（NVIDIA 平台）
CUSTOM_BASE_URL=https://integrate.api.nvidia.com/v1
CUSTOM_MODEL=deepseek-ai/deepseek-v4-pro
CUSTOM_API_KEY=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

# 各 Agent 可单独覆盖模型（可选）
ARCHITECT_MODEL=deepseek-ai/deepseek-v4-pro
WRITER_MODEL=deepseek-ai/deepseek-v4-pro
AUDITOR_MODEL=deepseek-ai/deepseek-v4-pro   # 审计用推理模型效果更好
REVISER_MODEL=deepseek-ai/deepseek-v4-pro

# 写作参数
DEFAULT_WORDS_PER_CHAPTER=4000
DEFAULT_TEMPERATURE=0.7
AUDITOR_TEMPERATURE=0.0             # 审计员锁温度 0，结果稳定
MAX_TOKENS=18192
LLM_TIMEOUT=600                     # 超时时间（秒），NVIDIA 平台可能需要更长时间
LLM_MAX_RETRIES=3                   # 请求失败时重试次数
LLM_RETRY_DELAY=5                   # 重试间隔（秒）

# 项目根目录
BOOKS_DIR=./books
