# Dramatica-Flow 配置（由 Web UI 写入）
LLM_PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-ed83052d22f344e9a28cf7847ccc128f

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# 写作参数
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=8192

# 各 Agent 模型配置（留空使用主模型）
ARCHITECT_MODEL=deepseek-v4-flash
WRITER_MODEL=deepseek-v4-pro
AUDITOR_MODEL=deepseek-v4-pro
REVISER_MODEL=deepseek-v4-pro

# LLM 高级配置
LLM_TIMEOUT=600
LLM_MAX_RETRIES=5
LLM_RETRY_DELAY=10
